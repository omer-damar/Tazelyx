# Sunucu
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/akilli-kiler
# Tarayıcıdan gelen isteklerde izin verilen origin'ler (virgülle ayrılmış).
# Boş bırakılırsa CORS tamamen açık kalır (yerel geliştirme varsayılanı) —
# mobil istemci zaten Origin başlığı göndermediği için bu ayardan etkilenmez.
# ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Kimlik doğrulama
JWT_SECRET=change-this-to-a-long-random-string

# Google Cloud Vision (fiş OCR)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/your-service-account.json

# AI sağlayıcı (fiş ayrıştırma, tarif önerisi, raf ömrü tahmini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# AI_MODEL=gemini-flash-latest

# Gerçek tarif kaynak linki (opsiyonel — anahtar yoksa özellik sessizce devre dışı kalır)
TAVILY_API_KEY=your-tavily-api-key

# E-posta (onay/şifre sıfırlama)
EMAIL_USER=your-email@example.com
EMAIL_APP_PASSWORD=your-email-app-password
EMAIL_SENDER_NAME=Tazelyx

# Telefon/tarayıcının bilgisayara ulaşacağı adresler (yerel ağ IP'si —
# geliştirme sırasında değişebilir, ipconfig/ifconfig ile kontrol edin)
APP_BASE_URL=http://192.168.1.100:4000
EXPO_APP_URL=exp://192.168.1.100:8081
